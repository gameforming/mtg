// ======================================================
// MTG GAME ENGINE
// ======================================================

let currentGame = null;


// ======================================================
// START GAME
// ======================================================

async function startGameEngine(
    mode,
    playerDeck,
    opponentDeck
) {

    const playerLibrary =
        prepareDeck(playerDeck);

    const opponentLibrary =
        prepareDeck(opponentDeck);


    currentGame = createGameState(
        mode,
        playerLibrary,
        opponentLibrary
    );


    shuffle(currentGame.players[0].library);
    shuffle(currentGame.players[1].library);


    logGame("Game started.");


    // Opening hands
    drawCards(
        0,
        mode.rules.startingHand
    );

    drawCards(
        1,
        mode.rules.startingHand
    );


    currentGame.status = "mulligan";


    openGamePage();

}


// ======================================================
// PREPARE DECK
// ======================================================

function prepareDeck(deck) {

    const cards = [];


    deck.cards.forEach(card => {

        for (
            let i = 0;
            i < card.amount;
            i++
        ) {

            cards.push({

                id: card.id,

                name: card.name,

                image: card.image,

                instanceId:
                    crypto.randomUUID(),

                tapped: false,

                summoningSickness: true,

                attacking: false,

                blocking: false,

                damage: 0,

                // Filled by card data later
                typeLine: "",

                oracleText: "",

                manaCost: "",

                power: null,

                toughness: null,

                colors: [],

                types: [],

                subtypes: []

            });

        }

    });


    return cards;

}


// ======================================================
// SHUFFLE
// ======================================================

function shuffle(array) {

    for (
        let i = array.length - 1;
        i > 0;
        i--
    ) {

        const j =
            Math.floor(
                Math.random() * (i + 1)
            );


        [
            array[i],
            array[j]
        ] = [
            array[j],
            array[i]
        ];

    }


    return array;

}


// ======================================================
// DRAW
// ======================================================

function drawCard(playerId) {

    const player =
        currentGame.players[playerId];


    if (player.library.length === 0) {

        loseGame(
            playerId,
            "You tried to draw from an empty library."
        );

        return null;

    }


    const card =
        player.library.pop();


    player.hand.push(card);


    logGame(
        `${player.name} drew ${card.name}.`
    );


    return card;

}


function drawCards(
    playerId,
    amount
) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        if (
            currentGame.status === "finished"
        ) {
            return;
        }

        drawCard(playerId);

    }

}


// ======================================================
// MULLIGAN
// ======================================================

function mulliganOpeningHand(playerId) {

    if (
        currentGame.status !== "mulligan"
    ) {
        return;
    }


    const player =
        currentGame.players[playerId];


    player.library.push(
        ...player.hand
    );


    player.hand = [];


    shuffle(
        player.library
    );


    drawCards(
        playerId,
        currentGame.modeData.rules.startingHand
    );


    player.mulligans++;


    renderGame();

}


// ======================================================
// KEEP HAND
// ======================================================

function keepOpeningHand(playerId) {

    if (
        currentGame.status !== "mulligan"
    ) {
        return;
    }


    const player =
        currentGame.players[playerId];


    if (player.handKept) {
        return;
    }


    player.handKept = true;


    checkMulliganFinished();

}


// ======================================================
// CHECK MULLIGAN
// ======================================================

function checkMulliganFinished() {

    const ready =
        currentGame.players.every(
            player => player.handKept
        );


    if (!ready) {

        renderGame();

        return;

    }


    startFirstTurn();

}


// ======================================================
// START FIRST TURN
// ======================================================

function startFirstTurn() {

    currentGame.status = "playing";

    currentGame.turn = 1;

    currentGame.activePlayer = 0;

    currentGame.firstTurn = true;

    currentGame.phase = "beginning";

    currentGame.step = "untap";


    logGame("The game begins.");

    beginTurn();

}


// ======================================================
// BEGIN TURN
// ======================================================

function beginTurn() {

    if (
        currentGame.status === "finished"
    ) {
        return;
    }


    const player =
        currentGame.players[
            currentGame.activePlayer
        ];


    currentGame.phase = "beginning";


    // Untap
    untapPlayer(player.id);


    // Remove summoning sickness
    player.battlefield.forEach(card => {

        card.summoningSickness = false;

    });


    // Mana resets
    player.mana.available = 0;

    player.mana.maximum = 0;


    // Upkeep
    currentGame.step = "upkeep";


    logGame(
        `Turn ${currentGame.turn}: ${player.name}'s upkeep.`
    );


    // Draw
    currentGame.step = "draw";


    // First player does not draw turn 1
    if (
        !(currentGame.turn === 1 &&
          player.id === 0)
    ) {

        drawCard(player.id);

    }


    currentGame.phase = "main1";

    currentGame.step = "main";


    renderGame();


    // AI
    if (
        player.id === 1
    ) {

        runAI();

    }

}


// ======================================================
// UNTAP
// ======================================================

function untapPlayer(playerId) {

    const player =
        currentGame.players[playerId];


    player.battlefield.forEach(card => {

        card.tapped = false;

        card.attacking = false;

        card.blocking = false;

        card.damage = 0;

    });


    logGame(
        `${player.name} untapped their permanents.`
    );

}


// ======================================================
// END TURN
// ======================================================

function endTurn() {

    if (
        currentGame.status !== "playing"
    ) {
        return;
    }


    const player =
        currentGame.players[
            currentGame.activePlayer
        ];


    player.battlefield.forEach(card => {

        card.attacking = false;

        card.blocking = false;

        card.damage = 0;

    });


    currentGame.activePlayer =
        currentGame.activePlayer === 0
            ? 1
            : 0;


    currentGame.turn++;


    logGame(
        `Turn ${currentGame.turn}: ` +
        `${currentGame.players[currentGame.activePlayer].name}'s turn.`
    );


    beginTurn();

}


// ======================================================
// NEXT PHASE
// ======================================================

function nextPhase() {

    if (
        currentGame.status !== "playing"
    ) {
        return;
    }


    if (
        currentGame.activePlayer !== 0
    ) {
        return;
    }


    switch (
        currentGame.phase
    ) {

        case "main1":

            currentGame.phase = "combat";

            currentGame.step = "beginning";

            startCombat();

            break;


        case "combat":

            currentGame.phase = "main2";

            currentGame.step = "main";

            renderGame();

            break;


        case "main2":

            currentGame.phase = "ending";

            currentGame.step = "end";

            renderGame();

            break;


        case "ending":

            endTurn();

            break;

    }

}


// ======================================================
// COMBAT
// ======================================================

function startCombat() {

    logGame("Combat begins.");

    currentGame.combat = {

        attackers: [],

        blockers: [],

        damageAssigned: false

    };


    renderGame();

}


// ======================================================
// DECLARE ATTACKERS
// ======================================================

function toggleAttack(cardInstanceId) {

    if (
        currentGame.status !== "playing"
    ) {
        return;
    }


    if (
        currentGame.activePlayer !== 0
    ) {
        return;
    }


    if (
        currentGame.phase !== "combat"
    ) {
        return;
    }


    const player =
        currentGame.players[0];


    const card =
        player.battlefield.find(
            card =>
                card.instanceId ===
                cardInstanceId
        );


    if (!card) {
        return;
    }


    if (
        card.tapped ||
        card.summoningSickness
    ) {
        return;
    }


    card.attacking =
        !card.attacking;


    if (card.attacking) {

        currentGame.combat.attackers.push(
            card.instanceId
        );

    } else {

        currentGame.combat.attackers =
            currentGame.combat.attackers.filter(
                id =>
                    id !== card.instanceId
            );

    }


    renderGame();

}


// ======================================================
// DECLARE BLOCKER
// ======================================================

function toggleBlock(
    blockerId,
    attackerId
) {

    const opponent =
        currentGame.players[1];


    const blocker =
        opponent.battlefield.find(
            card =>
                card.instanceId === blockerId
        );


    if (!blocker) {
        return;
    }


    blocker.blocking =
        !blocker.blocking;


    blocker.blockingTarget =
        blocker.blocking
            ? attackerId
            : null;


    renderGame();

}


// ======================================================
// RESOLVE COMBAT
// ======================================================

function resolveCombat() {

    const attackers =
        currentGame.players[0]
            .battlefield
            .filter(card =>
                card.attacking
            );


    const opponent =
        currentGame.players[1];


    for (const attacker of attackers) {

        attacker.tapped = true;


        const blocker =
            opponent.battlefield.find(
                card =>
                    card.blockingTarget ===
                    attacker.instanceId
            );


        if (!blocker) {

            dealDamage(
                1,
                attacker.power || 0
            );

            continue;

        }


        const attackerPower =
            Number(attacker.power) || 0;


        const blockerPower =
            Number(blocker.power) || 0;


        attacker.damage += blockerPower;

        blocker.damage += attackerPower;


        checkCreatureDeath(
            0
        );

        checkCreatureDeath(
            1
        );

    }


    currentGame.combat.attackers = [];


    renderGame();

}


// ======================================================
// DAMAGE TO PLAYER
// ======================================================

function dealDamage(
    playerId,
    amount
) {

    const player =
        currentGame.players[playerId];


    player.life -= amount;


    logGame(
        `${player.name} took ${amount} damage.`
    );


    if (
        player.life <= 0
    ) {

        loseGame(
            playerId,
            "Life reached zero."
        );

    }

}


// ======================================================
// CREATURE DEATH
// ======================================================

function checkCreatureDeath(playerId) {

    const player =
        currentGame.players[playerId];


    const dead =
        player.battlefield.filter(card => {

            if (
                card.toughness === null
            ) {
                return false;
            }


            return (
                card.damage >=
                Number(card.toughness)
            );

        });


    dead.forEach(card => {

        player.battlefield =
            player.battlefield.filter(
                c =>
                    c.instanceId !==
                    card.instanceId
            );


        player.graveyard.push(card);


        logGame(
            `${card.name} was destroyed.`
        );

    });

}


// ======================================================
// PLAY LAND
// ======================================================

function playLand(
    playerId,
    cardInstanceId
) {

    const player =
        currentGame.players[playerId];


    if (
        playerId !==
        currentGame.activePlayer
    ) {
        return false;
    }


    if (
        currentGame.phase !== "main1" &&
        currentGame.phase !== "main2"
    ) {
        return false;
    }


    if (
        player.landsPlayed >= 1
    ) {
        return false;
    }


    const index =
        player.hand.findIndex(
            card =>
                card.instanceId ===
                cardInstanceId
        );


    if (index === -1) {
        return false;
    }


    const card =
        player.hand[index];


    if (
        !isLand(card)
    ) {
        return false;
    }


    player.hand.splice(
        index,
        1
    );


    player.battlefield.push(card);


    player.landsPlayed++;


    logGame(
        `${player.name} played ${card.name}.`
    );


    renderGame();


    return true;

}


// ======================================================
// TAP LAND FOR MANA
// ======================================================

function tapLand(
    playerId,
    cardInstanceId
) {

    const player =
        currentGame.players[playerId];


    const card =
        player.battlefield.find(
            card =>
                card.instanceId ===
                cardInstanceId
        );


    if (!card) {
        return;
    }


    if (!isLand(card)) {
        return;
    }


    if (card.tapped) {
        return;
    }


    card.tapped = true;


    player.mana.available++;


    logGame(
        `${player.name} generated 1 mana.`
    );


    renderGame();

}


// ======================================================
// CAST CARD
// ======================================================

function castCard(
    playerId,
    cardInstanceId
) {

    const player =
        currentGame.players[playerId];


    const index =
        player.hand.findIndex(
            card =>
                card.instanceId ===
                cardInstanceId
        );


    if (index === -1) {
        return false;
    }


    const card =
        player.hand[index];


    if (isLand(card)) {

        return false;

    }


    const cost =
        getManaCost(card);


    if (
        player.mana.available <
        cost
    ) {

        logGame(
            `Not enough mana for ${card.name}.`
        );

        return false;

    }


    player.mana.available -= cost;


    player.hand.splice(
        index,
        1
    );


    // Creature
    if (
        isCreature(card)
    ) {

        card.summoningSickness = true;

        player.battlefield.push(card);


        logGame(
            `${player.name} cast ${card.name}.`
        );


        return true;

    }


    // Instant / Sorcery
    if (
        isInstant(card) ||
        isSorcery(card)
    ) {

        resolveSpell(
            playerId,
            card
        );

        return true;

    }


    return false;

}


// ======================================================
// SPELL RESOLUTION
// ======================================================

function resolveSpell(
    playerId,
    card
) {

    const opponentId =
        playerId === 0
            ? 1
            : 0;


    // Basic damage spell detection
    const text =
        (
            card.oracleText ||
            ""
        ).toLowerCase();


    const damageMatch =
        text.match(
            /deals?\s+(\d+)\s+damage/
        );


    if (damageMatch) {

        const amount =
            Number(
                damageMatch[1]
            );


        dealDamage(
            opponentId,
            amount
        );

    }


    // Basic draw detection
    if (
        text.includes("draw a card")
    ) {

        drawCard(
            playerId
        );

    }


    // Spell goes to graveyard
    currentGame.players[playerId]
        .graveyard
        .push(card);


    logGame(
        `${card.name} resolved.`
    );


    renderGame();

}


// ======================================================
// CARD TYPES
// ======================================================

function isLand(card) {

    return card.types.includes(
        "Land"
    );

}


function isCreature(card) {

    return card.types.includes(
        "Creature"
    );

}


function isInstant(card) {

    return card.types.includes(
        "Instant"
    );

}


function isSorcery(card) {

    return card.types.includes(
        "Sorcery"
    );

}


// ======================================================
// MANA COST
// ======================================================

function getManaCost(card) {

    if (!card.manaCost) {
        return 0;
    }


    const matches =
        card.manaCost.match(
            /\{(\d+)\}/g
        );


    let cost = 0;


    if (matches) {

        matches.forEach(value => {

            cost +=
                Number(
                    value.replace(
                        /[{}]/g,
                        ""
                    )
                );

        });

    }


    // Colored mana currently counts
    // as one generic mana each.
    //
    // We will replace this with a real
    // colored mana system next.

    const colored =
        card.manaCost.match(
            /\{[WUBRGC]\}/g
        );


    if (colored) {

        cost +=
            colored.length;

    }


    return cost;

}


// ======================================================
// WIN / LOSE
// ======================================================

function loseGame(
    playerId,
    reason
) {

    if (
        currentGame.status === "finished"
    ) {
        return;
    }


    const player =
        currentGame.players[playerId];


    player.hasLost = true;


    const winnerId =
        playerId === 0
            ? 1
            : 0;


    const winner =
        currentGame.players[winnerId];


    winner.hasWon = true;


    currentGame.winner =
        winnerId;


    currentGame.status =
        "finished";


    logGame(
        `${player.name} lost: ${reason}`
    );


    logGame(
        `${winner.name} wins!`
    );


    renderGame();

}


// ======================================================
// GAME LOG
// ======================================================

function logGame(message) {

    if (!currentGame) {
        return;
    }


    currentGame.log.push({

        turn:
            currentGame.turn,

        message:
            message,

        timestamp:
            Date.now()

    });

}


// ======================================================
// CURRENT PLAYER
// ======================================================

function getCurrentPlayer() {

    return currentGame.players[
        currentGame.activePlayer
    ];

}
